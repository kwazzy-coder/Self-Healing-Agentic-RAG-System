# Copy to .env and fill in ONE provider key (all have free tiers except OpenAI).
# Provider: gemini | groq | openai | ollama | huggingface
LLM_BACKEND=groq

GROQ_API_KEY=            # https://console.groq.com/keys      (free, fast)
GEMINI_API_KEY=          # https://aistudio.google.com/apikey (free)
OPENAI_API_KEY=          # paid

# Optional overrides
# LLM_MODEL=openai/gpt-oss-20b
# LLM_REASONING_EFFORT=low
# MIN_OUTPUT_TOKENS=1024     # reasoning tokens count toward this; lower it if you hit tokens-per-minute limits
# OLLAMA_MODEL=llama3.2
# TOP_K_RETRIEVAL=5
# MAX_CORRECTION_ATTEMPTS=2
# NLI_LOW=0.2
# NLI_HIGH=0.7
# LOG_LEVEL=INFO
